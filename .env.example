NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL canonica del sitio en produccion (sin slash final). Usada como destino
# fijo del redirectTo de OAuth (Google) para que nunca dependa de una
# deteccion en tiempo de ejecucion. Dejar vacia en desarrollo local: el
# codigo cae de vuelta a window.location.origin (http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://lumen-app-lime.vercel.app

# Solo para scripts de servidor/administracion (migraciones, seeds). Nunca
# se importa en codigo que corra en el navegador ni en Server Actions comunes.
SUPABASE_SERVICE_ROLE_KEY=

# Selecciona el proveedor de IA detras de infrastructure/ai/adapter.ts.
# "mock" no requiere credenciales.
# "gemini" usa Google Gemini 1.5 Flash directo (nivel gratuito) — modo $0 recomendado.
# "openai" activa OpenAiExtractionProvider (requiere OPENAI_API_KEY, de pago).
# "anthropic" activa el motor resiliente: Claude 3.5 Haiku (principal, de pago)
# con Gemini 1.5 Flash como respaldo automatico si Anthropic falla.
AI_PROVIDER=gemini

# Solo si AI_PROVIDER=openai.
OPENAI_API_KEY=
# Opcional: apunta a "https://openrouter.ai/api/v1" para usar OpenRouter en vez de OpenAI.
OPENAI_BASE_URL=
# Opcional: default "gpt-4o-mini". Debe soportar Structured Outputs (response_format json_schema).
OPENAI_MODEL=

# Solo si AI_PROVIDER=anthropic (motor principal, de pago).
ANTHROPIC_API_KEY=
# Opcional: default "claude-3-5-haiku-20241022".
ANTHROPIC_MODEL=

# Requerida si AI_PROVIDER=gemini o AI_PROVIDER=anthropic (como respaldo).
# Genera una gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: default "gemini-2.5-flash".
GEMINI_MODEL=

# Correo visible de soporte (pie de pagina, /settings).
NEXT_PUBLIC_SUPPORT_EMAIL=soporte.lumen.app@gmail.com

# Token que exige /api/cron/health-check en el header
# "Authorization: Bearer <CRON_SECRET>". Genera uno propio y configuralo
# tambien en el servicio que dispare el cron (Vercel Cron u otro).
CRON_SECRET=
